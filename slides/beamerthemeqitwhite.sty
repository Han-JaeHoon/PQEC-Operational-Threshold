% ---------------------------------------------------------------------------
% qitwhite -- a minimal Keynote-like Beamer theme:
% pure white background, near-black text, left-aligned bold sans headings,
% no navigation furniture, one restrained accent colour.
% ---------------------------------------------------------------------------
\ProvidesPackage{beamerthemeqitwhite}[2026/10/11 Keynote-like white theme]

\mode<presentation>

% ---- colours --------------------------------------------------------------
\definecolor{qitink}   {HTML}{111111}   % body text
\definecolor{qitink2}  {HTML}{4A4A4A}   % secondary text
\definecolor{qitgray}  {HTML}{8A8A8A}   % tertiary / page number
\definecolor{qitrule}  {HTML}{D9D9D9}   % hairlines
\definecolor{qitaccent}{HTML}{1F5FA9}   % the single accent
\definecolor{qitwarn}  {HTML}{B4461E}   % used only for "open / not proved"

% Bell-state palette, identical to the figure palette
\definecolor{bphip}{HTML}{2A78D6}
\definecolor{bphim}{HTML}{EB6834}
\definecolor{bpsip}{HTML}{1BAF7A}
\definecolor{bpsim}{HTML}{EDA100}

% ---- global palette -------------------------------------------------------
\setbeamercolor{normal text}     {fg=qitink,   bg=white}
\setbeamercolor{structure}       {fg=qitaccent}
\setbeamercolor{alerted text}    {fg=qitaccent}
\setbeamercolor{frametitle}      {fg=qitink,   bg=white}
\setbeamercolor{framesubtitle}   {fg=qitgray,  bg=white}
\setbeamercolor{title}           {fg=qitink}
\setbeamercolor{subtitle}        {fg=qitink2}
\setbeamercolor{author}          {fg=qitgray}
\setbeamercolor{itemize item}    {fg=qitgray}
\setbeamercolor{itemize subitem} {fg=qitrule}
\setbeamercolor{enumerate item}  {fg=qitaccent}
\setbeamercolor{block title}     {fg=qitink,   bg=white}
\setbeamercolor{block body}      {fg=qitink,   bg=white}
\setbeamercolor{caption name}    {fg=qitgray}

% ---- fonts ----------------------------------------------------------------
\setbeamerfont{frametitle}   {size=\Large,      series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,      series=\mdseries}
\setbeamerfont{title}        {size=\LARGE,      series=\bfseries}
\setbeamerfont{subtitle}     {size=\normalsize, series=\mdseries}
\setbeamerfont{author}       {size=\small}
\setbeamerfont{block title}  {size=\normalsize, series=\bfseries}
\setbeamerfont{caption}      {size=\scriptsize}

% ---- furniture: remove all of it ------------------------------------------
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{blocks}[default]
\setbeamertemplate{caption}{\insertcaption}
\setbeamertemplate{caption label separator}{}

% markers: a small dash, Keynote style
\setbeamertemplate{itemize item}      {\rule[0.28ex]{1.1ex}{0.9pt}}
\setbeamertemplate{itemize subitem}   {\rule[0.28ex]{0.7ex}{0.8pt}}
\setbeamertemplate{itemize subsubitem}{\rule[0.28ex]{0.5ex}{0.7pt}}

% frame title: left aligned, hairline underneath
\setbeamertemplate{frametitle}{%
  \vskip 0.5ex%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.055\paperwidth,%
                         rightskip=0.055\paperwidth]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else
      \\[0.25ex]{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
        \insertframesubtitle}%
    \fi
    \\[0.35ex]{\color{qitrule}\rule{\dimexpr\paperwidth-0.11\paperwidth\relax}{0.5pt}}%
  \end{beamercolorbox}%
  \vskip 0.2ex%
}

% footline: nothing but a page number, far right, very light
\setbeamertemplate{footline}{%
  \hfill\raisebox{1.1ex}[0pt][0pt]{%
    \color{qitgray}\scriptsize\insertframenumber\hspace{0.045\paperwidth}}%
  \vskip 0.7ex%
}

\setbeamersize{text margin left=0.055\paperwidth,
               text margin right=0.055\paperwidth}

\mode<all>
